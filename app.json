{
  "expo": {
    "name": "Gacuruzi BarberShop",
    "slug": "gacurizi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quick.png",
    "scheme": "gacurizi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.gacurizi.barber",
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.gacurizi.barber",
        "adaptiveIcon": {
        "foregroundImage": "./assets/images/quick.png",
        "backgroundColor": "#F5F5DC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/quick.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5DC",
          "dark": {
            "backgroundColor": "#F5F5DC"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d6ca239-fe07-43ca-8a96-7edb45090cb9"
      }
    }
  }
}
